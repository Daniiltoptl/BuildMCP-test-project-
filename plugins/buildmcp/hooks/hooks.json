{
  "description": "Готовит Python-окружение BuildMCP (первый запуск ставит зависимости, дальше — мгновенно).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["sync", "--quiet", "--frozen", "--project", "${CLAUDE_PLUGIN_ROOT}/server"],
            "timeout": 900
          }
        ]
      }
    ]
  }
}
